# ---- AI engine: NO API KEY NEEDED ----
# docker-compose.yml runs an open-source model (Ollama) next to Santo automatically.
# Pick a model that fits your server's memory:
#   qwen2.5:3b   ~2 GB RAM  good default, fast on CPU, supports tools (bookings, leads)
#   llama3.2:3b  ~2 GB RAM  alternative small model
#   qwen2.5:7b   ~5 GB RAM  smarter answers, needs 8 GB+ server
#   llama3.1:8b  ~5 GB RAM  smarter answers, needs 8 GB+ server
OLLAMA_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
# Running without Docker? Install Ollama from ollama.com, then set:
# OLLAMA_URL=http://localhost:11434
# No model server at all (e.g. free hosting)? Santo uses its built-in engine:
# it answers from your documents and still captures leads and bookings.
# AI_TIMEOUT_SECONDS=120

# Optional, only if you ever want a paid cloud model instead:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDER=ollama          # force: ollama | local | anthropic | openai

# ---- Security ----
API_KEYS=change-me-1,change-me-2   # required for /mcp, /api/admin/*, and non-public agents
PUBLIC_AGENTS=*                    # agents usable without a key ("*" = all). If you list them, keep "santo" for the homepage
CORS_ORIGINS=*                     # e.g. https://acme.example,https://www.acme.example
RATE_LIMIT_PER_MIN=30

# ---- Sessions ----
SESSION_TTL_SECONDS=3600
MAX_HISTORY_MESSAGES=20

# ---- Secrets referenced by agents/*.yaml http_tools as ${VAR} ----
ORDERS_API_URL=
ORDERS_API_TOKEN=
RESERVATIONS_WEBHOOK_URL=

# ---- Storage ----
# DATABASE_PATH=/app/data/santo.db   # SQLite file for sign-ups and conversation logs

# ---- Website address (used for SEO: canonical links, sitemap.xml) ----
SITE_URL=https://heysanto.ai
